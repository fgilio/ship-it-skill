{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": [
      "error",
      { "ignoreRestSiblings": true, "argsIgnorePattern": "^_" }
    ]
  },
  "ignorePatterns": ["test/fixtures/**"]
}
